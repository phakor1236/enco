# ---------------------------------------------------------------------------
# VELLA — environment variables (copy to .env and fill in)
# ---------------------------------------------------------------------------
# .env is gitignored. Never commit real secrets.
# All values below are safe DEV defaults to use with `docker compose up -d`.

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173

# --- Database ---------------------------------------------------------------
# App database (used by `apps/api` runtime + `pnpm db:migrate` + `pnpm db:seed`)
DATABASE_URL=postgresql://vella:vella_dev_pw@localhost:5433/vella

# Test database (used by Vitest integration tests; separate from app DB so
# parallel `pnpm dev` and `pnpm test` don't collide)
TEST_DATABASE_URL=postgresql://vella:vella_dev_pw@localhost:5433/vella_test

# --- Auth -------------------------------------------------------------------
# JWT signing secret for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED in production; dev default is fine for local.
JWT_SECRET=dev_only_replace_in_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS / Cookies ---------------------------------------------------------
# In dev the FE talks to /api via Vite proxy (same-origin), so CORS is unused.
# In prod the FE talks to the API via Vercel rewrites (also same-origin).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Rate limit (optional overrides) ---------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_DAY_PER_IP=3

# --- Demo readonly (prod online demo only; leave false for local) ----------
DEMO_READONLY_ENABLED=false
