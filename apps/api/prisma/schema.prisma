// VELLA — Prisma schema
// Models are added per-slice (T1.1 owns User + RefreshToken, T2.x catalog, etc.)
// to keep one migration per concern and avoid mid-stream redefinitions.

generator client {
  provider = "prisma-client-js"
  // Output stays in default location (node_modules/.prisma/client)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
