// VELLA — Prisma schema
// Models are added per-slice (T1.1 owns User + RefreshToken, T2.x catalog, etc.)
// to keep one migration per concern and avoid mid-stream redefinitions.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// T1.1 — Auth
// ============================================================================

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           Role     @default(CUSTOMER)
  isDemoReadonly Boolean  @default(false) @map("is_demo_readonly")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  carts                   Cart[]
  orders                  Order[]
  orderStatusLogsOperated OrderStatusLog[] @relation("OrderStatusLogOperator")
  couponUsages            CouponUsage[]

  @@map("users")
}

/// Opaque refresh tokens — DB stores SHA-256 hash only (never the plaintext).
/// `familyId` groups a rotation chain so reuse detection can revoke just the
/// affected family without nuking sibling devices.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  parentId  String?   @map("parent_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// T2.1 — Product Catalog
// ============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SkuStatus {
  ACTIVE
  ARCHIVED
}

/// Hierarchical category tree (self-reference via parentId).
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

/// `basePrice` is the display price; effective price always comes from the
/// chosen SKU (variants may price-differ). Status drives storefront visibility
/// and merge-on-login gating (ARCHIVED items silently dropped — SPEC §5).
model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  categoryId  String        @map("category_id")
  basePrice   Decimal       @map("base_price") @db.Decimal(10, 2)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  variants Variant[]
  skus     Sku[]

  // Drives storefront list query: filter by category + status, sort by createdAt.
  @@index([categoryId, status, createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
  @@map("product_images")
}

/// A variant axis ("Color", "Size"). One product can have multiple axes.
model Variant {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options VariantOption[]

  @@unique([productId, name])
  @@map("variants")
}

/// A single value along a variant axis ("Red" under "Color").
model VariantOption {
  id        String @id @default(cuid())
  variantId String @map("variant_id")
  value     String
  sort      Int    @default(0)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, value])
  @@index([variantId, sort])
  @@map("variant_options")
}

/// `optionCombination` is a denormalized JSON view of the variant choices
/// resolved to this SKU (e.g. `{"Color":"Red","Size":"M"}`). It powers the
/// storefront variant picker without an N-join. ADR T8.5 captures the
/// consistency trade-off vs the normalized VariantOption rows.
model Sku {
  id                String    @id @default(cuid())
  productId         String    @map("product_id")
  code              String    @unique
  price             Decimal   @db.Decimal(10, 2)
  stock             Int       @default(0)
  optionCombination Json      @map("option_combination")
  status            SkuStatus @default(ACTIVE)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, status])
  @@map("skus")
}

// ============================================================================
// T3.1 — Cart + CartItem
// ============================================================================

/// Single cart per user OR per guest session. The "at least one owner" rule
/// is enforced by a CHECK constraint added in the migration (Prisma can't
/// express it declaratively). Two partial unique indexes — also raw SQL —
/// enforce "one cart per user_id (when set)" and "one per session_id (when
/// set)" without forcing both columns NOT NULL.
///
/// guest cookie `cart_session` (HttpOnly+Lax, 7-day sliding TTL) carries
/// the session_id. Phase 7 cron drops stale guest carts (T7.5).
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  // Drives the T7.5 sweep of `updated_at < now() - 7d AND user_id IS NULL`.
  @@index([updatedAt])
  @@map("carts")
}

/// One row per (cart, sku). Quantity > 0 is enforced by a CHECK constraint
/// in the migration. Sku FK is Restrict so admins can't accidentally hard-
/// delete a SKU sitting in someone's cart — they must archive instead.
model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  skuId     String   @map("sku_id")
  qty       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([cartId, skuId])
  @@map("cart_items")
}

// ============================================================================
// T4.1 — Order family
// ============================================================================

/// State machine vertices. Transitions (PENDING→PAID, PAID→SHIPPED, …) are
/// enforced in `transitionOrder()` (T4.2). PAID→CANCELLED is intentionally
/// missing per SPEC §5 — paid orders must take the REFUNDED path so the
/// "cancel + refund" semantics stay merged.
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMockStatus {
  PENDING
  SUCCESS
  FAILURE
  REFUNDED
}

/// Drives the mock webhook's behavior at PaymentMock creation time:
///   AUTO_SUCCESS → setTimeout fires success webhook → PENDING→PAID
///   AUTO_FAILURE → setTimeout fires failure webhook → PENDING→CANCELLED
///                 (the E2E unhappy path — T8.9 exercises this)
///   MANUAL       → SUPER_ADMIN dashboard triggers the webhook by hand
enum PaymentOutcomeMode {
  AUTO_SUCCESS
  AUTO_FAILURE
  MANUAL
}

enum ShipmentStatus {
  IN_TRANSIT
  DELIVERED
}

/// One row per checkout. Money columns are frozen at checkout time so a
/// later coupon edit / base-price change can never retroactively rewrite
/// historical totals. The state field is mutated ONLY via `transitionOrder`
/// — routes and admin handlers MUST NOT assign to it directly (SPEC §5).
///
/// `paymentIntentId` is the upstream PSP's idempotency key. `@unique` on a
/// nullable column gives us "at most one row per intent once attached"
/// (Postgres treats multiple NULL values as distinct under a UNIQUE
/// constraint, so PENDING orders before payment attach don't collide).
/// T4.4's webhook handler uses this to make the PAID transition idempotent
/// via a conditional UPDATE that affects zero rows on replay.
model Order {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  status          OrderStatus @default(PENDING)
  paymentIntentId String?     @unique @map("payment_intent_id")
  subtotal        Decimal     @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  shippingFee     Decimal     @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  shippingAddress Json        @map("shipping_address")
  paymentMethod   String      @map("payment_method")
  createdAt       DateTime    @default(now()) @map("created_at")
  paidAt          DateTime?   @map("paid_at")
  shippedAt       DateTime?   @map("shipped_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  logs      OrderStatusLog[]
  payments  PaymentMock[]
  shipments ShipmentMock[]
  couponUsage CouponUsage?

  // Drives "我的訂單" list (newest first) and sales reports (range scans).
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

/// `unitPrice` is the calculation source — frozen at checkout, never read
/// from the SKU again. `skuSnapshot` is display-only (product name, SKU
/// code, option combo, primary image URL) so receipts keep rendering even
/// after a SKU is archived or renamed. Strict semantic split keeps report
/// totals identical to what the customer saw at checkout.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  skuId       String  @map("sku_id")
  skuSnapshot Json    @map("sku_snapshot")
  qty         Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  // Mirror CartItem's invariant: one row per (order, SKU). Checkout dedups
  // upstream from the cart today, but the schema-level guarantee defends
  // future retry / replay paths from silently doubling line counts.
  // `qty > 0` is added via raw SQL in the migration (Prisma can't express
  // CHECK declaratively).
  @@unique([orderId, skuId])
  @@index([orderId])
  @@map("order_items")
}

/// One row per state transition, written inside the same tx as the status
/// change so the log can never disagree with Order.status. `operatorId`
/// is nullable for system-driven transitions (cron auto-cancel, webhook).
/// FK is SetNull so deleting a stale admin account doesn't nuke audit
/// history.
model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  operatorId String?      @map("operator_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operator User? @relation("OrderStatusLogOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

/// Fake PSP integration. The portfolio doesn't talk to a real payment
/// provider, but the schema mirrors one closely enough that a future
/// swap-in would be a service-layer change, not a data-model change.
/// Multiple rows per Order are allowed — a REFUNDED transition inserts a
/// second row (the refund) rather than mutating the original.
model PaymentMock {
  id           String             @id @default(cuid())
  orderId      String             @map("order_id")
  provider     String
  status       PaymentMockStatus  @default(PENDING)
  outcomeMode  PaymentOutcomeMode @default(AUTO_SUCCESS) @map("outcome_mode")
  mockResponse Json               @map("mock_response")
  createdAt    DateTime           @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_mocks")
}

// ============================================================================
// T5.1 — Coupon + CouponUsage
// ============================================================================

/// Discount type: FIXED subtracts a flat amount; PERCENT takes `value`% off.
/// `value` is always stored as-is — callers apply `Math.min(discount, subtotal)`
/// so a 100% coupon never produces a negative total.
enum CouponType {
  FIXED
  PERCENT
}

/// `usageLimit` null = unlimited (first-come-first-served up to users × 1).
/// `minAmount` null = no minimum. `startsAt`/`endsAt` null = open-ended.
/// The CHECK constraints enforcing `value > 0` and `usage_limit > 0` are
/// added via raw SQL in the migration (Prisma can't express them declaratively).
model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique
  type       CouponType
  value      Decimal    @db.Decimal(10, 2)
  minAmount  Decimal?   @map("min_amount") @db.Decimal(10, 2)
  startsAt   DateTime?  @map("starts_at")
  endsAt     DateTime?  @map("ends_at")
  usageLimit Int?       @map("usage_limit")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  usages CouponUsage[]

  @@map("coupons")
}

/// One row per (coupon, user) pair — UNIQUE enforces the one-per-user rule
/// at the DB level so no service-layer retry can sneak a duplicate through.
/// FK to Order is Cascade so cancelling an order also clears its usage row,
/// allowing the user to reuse the coupon after a rollback or cancel.
model CouponUsage {
  id       String   @id @default(cuid())
  couponId String   @map("coupon_id")
  userId   String   @map("user_id")
  orderId  String   @unique @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Core invariant: one use per (coupon, user). DB-level — not application-level.
  @@unique([couponId, userId])
  @@index([couponId])
  @@map("coupon_usages")
}

/// Created during the PAID→SHIPPED transition (T4.2). The tracking number
/// is generated locally but kept UNIQUE so the order page can render a
/// "real-looking" tracking link without collisions.
model ShipmentMock {
  id         String         @id @default(cuid())
  orderId    String         @map("order_id")
  carrier    String
  trackingNo String         @unique @map("tracking_no")
  status     ShipmentStatus @default(IN_TRANSIT)
  createdAt  DateTime       @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipment_mocks")
}
