// VELLA — Prisma schema
// Models are added per-slice (T1.1 owns User + RefreshToken, T2.x catalog, etc.)
// to keep one migration per concern and avoid mid-stream redefinitions.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// T1.1 — Auth
// ============================================================================

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           Role     @default(CUSTOMER)
  isDemoReadonly Boolean  @default(false) @map("is_demo_readonly")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  carts         Cart[]

  @@map("users")
}

/// Opaque refresh tokens — DB stores SHA-256 hash only (never the plaintext).
/// `familyId` groups a rotation chain so reuse detection can revoke just the
/// affected family without nuking sibling devices.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  parentId  String?   @map("parent_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// T2.1 — Product Catalog
// ============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SkuStatus {
  ACTIVE
  ARCHIVED
}

/// Hierarchical category tree (self-reference via parentId).
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

/// `basePrice` is the display price; effective price always comes from the
/// chosen SKU (variants may price-differ). Status drives storefront visibility
/// and merge-on-login gating (ARCHIVED items silently dropped — SPEC §5).
model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  categoryId  String        @map("category_id")
  basePrice   Decimal       @map("base_price") @db.Decimal(10, 2)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  variants Variant[]
  skus     Sku[]

  // Drives storefront list query: filter by category + status, sort by createdAt.
  @@index([categoryId, status, createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
  @@map("product_images")
}

/// A variant axis ("Color", "Size"). One product can have multiple axes.
model Variant {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options VariantOption[]

  @@unique([productId, name])
  @@map("variants")
}

/// A single value along a variant axis ("Red" under "Color").
model VariantOption {
  id        String @id @default(cuid())
  variantId String @map("variant_id")
  value     String
  sort      Int    @default(0)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, value])
  @@index([variantId, sort])
  @@map("variant_options")
}

/// `optionCombination` is a denormalized JSON view of the variant choices
/// resolved to this SKU (e.g. `{"Color":"Red","Size":"M"}`). It powers the
/// storefront variant picker without an N-join. ADR T8.5 captures the
/// consistency trade-off vs the normalized VariantOption rows.
model Sku {
  id                String    @id @default(cuid())
  productId         String    @map("product_id")
  code              String    @unique
  price             Decimal   @db.Decimal(10, 2)
  stock             Int       @default(0)
  optionCombination Json      @map("option_combination")
  status            SkuStatus @default(ACTIVE)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems CartItem[]

  @@index([productId, status])
  @@map("skus")
}

// ============================================================================
// T3.1 — Cart + CartItem
// ============================================================================

/// Single cart per user OR per guest session. The "at least one owner" rule
/// is enforced by a CHECK constraint added in the migration (Prisma can't
/// express it declaratively). Two partial unique indexes — also raw SQL —
/// enforce "one cart per user_id (when set)" and "one per session_id (when
/// set)" without forcing both columns NOT NULL.
///
/// guest cookie `cart_session` (HttpOnly+Lax, 7-day sliding TTL) carries
/// the session_id. Phase 7 cron drops stale guest carts (T7.5).
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  // Drives the T7.5 sweep of `updated_at < now() - 7d AND user_id IS NULL`.
  @@index([updatedAt])
  @@map("carts")
}

/// One row per (cart, sku). Quantity > 0 is enforced by a CHECK constraint
/// in the migration. Sku FK is Restrict so admins can't accidentally hard-
/// delete a SKU sitting in someone's cart — they must archive instead.
model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  skuId     String   @map("sku_id")
  qty       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([cartId, skuId])
  @@map("cart_items")
}
